{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Basic user information",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "createdAt"]
    },
    "Session": {
      "title": "Journaling Session",
      "description": "A single chat session between user and AI coach",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "completed"] },
        "messages": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "role": { "type": "string", "enum": ["user", "model"] },
              "content": { "type": "string" },
              "timestamp": { "type": "string", "format": "date-time" }
            }
          }
        },
        "report": { "type": "string", "description": "Markdown report generated at the end" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "status", "createdAt", "updatedAt"]
    },
    "Note": {
      "title": "Journal Note",
      "description": "A saved journal report as a permanent note",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "sessionId": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "keywords": { "type": "string", "description": "#hashtag, #style keywords" },
        "summary": { "type": "string", "description": "One-sentence summary of the session" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "content", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile document"
    },
    "/users/{userId}/sessions/{sessionId}": {
      "schema": "Session",
      "description": "Individual journaling sessions"
    },
    "/users/{userId}/notes/{noteId}": {
      "schema": "Note",
      "description": "Saved notes/reports"
    }
  }
}
