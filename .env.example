# ANTHROPIC_API_KEY: Required for Anthropic API calls.
# Set this in local .env.local and Vercel project environment variables.
ANTHROPIC_API_KEY="YOUR_ANTHROPIC_API_KEY"

# Optional: Override Claude model.
ANTHROPIC_MODEL="claude-3-7-sonnet-latest"
# Optional: comma-separated fallback candidates.
# Example: "claude-sonnet-4-20250514,claude-3-7-sonnet-20250219"
ANTHROPIC_MODEL_CANDIDATES=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
